src/
└── app/
    ├── core/                # Imported ONCE at application startup (singleton core logic)
    │   ├── layout/          # Application layout templates and structural components
    │   │   ├── shell/       # Core application shell (combines header, footer, and sidebar)
    │   │   ├── header/      # Main top navigation bar
    │   │   └── footer/      # Application bottom footer with links and copyright
    │   ├── guards/          # AuthGuard, AdminGuard
    │   ├── interceptors/    # HTTP Request interceptors (e.g., adding JWT tokens)
    │   └── services/        # Global services (AuthService, ThemeService)
    │
    ├── shared/              # Reusable elements shared ACROSS the entire site
    │   ├── ui/              # Reusable UI elements (buttons, spinners, custom inputs)
    │   └── pipes/           # Custom pipes (e.g., format-date.pipe.ts)
    │
    ├── features/            # Business logic / domain modules (instead of a global pages folder)
    │   ├── auth/            # Everything related to authentication
    │   │   ├── login/       # Login component (contains .ts, .html, .scss)
    │   │   ├── register/    # Register component
    │   │   └── auth.routes.ts
    │   │
    │   ├── .../             # ... feature
    │   │   ├── components/  # Sub-components used ONLY within the ... feature
    │   │   │   └── .../ 
    │   │   ├── pages/       # Specific screens/views for this feature
    │   │   │   ├── ...-list/
    │   │   │   └── ...-details/
    │   │   └── ....routes.ts
    │   │
    │   ├── research/        # Everything related to research
    │   ├── powered/         # Everything related to powered
    │   ├── blog/            # Everything related to blog
    │   │
    │   └── home/            # Home page component
    │
    ├── app.config.ts        # Global application configuration (instead of app.module.ts)
    └── app.routes.ts        # Main routing configuration (loads features via lazy loading)