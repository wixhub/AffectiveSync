│ ├── .../ # ... feature
│ │ ├── components/ # Sub-components used ONLY within the ... feature
│ │ │ └── .../
│ │ ├── pages/ # Specific screens/views for this feature
│ │ │ ├── ...-list/
│ │ │ └── ...-details/
│ │ └── ....routes.ts
│ │
│ ├── research/ # Everything related to research
